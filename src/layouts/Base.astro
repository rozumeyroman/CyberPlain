---
import { site } from '../../site.config';
import Logo from '../components/Logo.astro';
import '../styles/tokens.css';
import '../styles/base.css';

const { title, description = site.description } = Astro.props;
const fullTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.tagline}`;
const colorVars = `:root{${Object.entries(site.colors).map(([k, v]) => `--${k}:${v}`).join(';')}}`;

const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site).href;
const ogImage = new URL(site.ogImage, Astro.site).href;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<!doctype html>
<html lang="uk">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  <meta name="theme-color" content={site.colors.bg}>
  <link rel="canonical" href={canonical}>
  <meta property="og:type" content="website">
  <meta property="og:site_name" content={site.name}>
  <meta property="og:locale" content="uk_UA">
  <meta property="og:title" content={fullTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="sitemap" href="/sitemap-index.xml">
  <link rel="icon" href="/favicon.ico" sizes="48x48">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Onest:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap">
  <style is:inline set:html={colorVars}></style>
</head>
<body>
  <header class="header">
    <div class="wrap header-in">
      <a href="/" class="brand"><Logo /><span>{site.name}</span></a>
      <nav aria-label="Розділи сайту" class="tabs">
        {site.tabs.map((t) => (
          <a href={t.href} class:list={['tab', 'mono', { on: isActive(t.href) }]} aria-current={isActive(t.href) ? 'page' : undefined}>{t.label}</a>
        ))}
      </nav>
    </div>
  </header>

  <main><slot /></main>

  <footer class="foot">
    <div class="wrap foot-in">
      <div class="foot-top">
        <span class="brand"><Logo size={18} />{site.name}</span>
        <nav aria-label="Службові посилання" class="mono foot-links">
          {site.footer.links.map((l) => <a href={l.href}>{l.label}</a>)}
        </nav>
      </div>
      <div class="notes">
        {site.footer.notes.map((n) => <p set:html={n} />)}
        <p>Автор: <a href={site.author.url}>{site.author.name}</a>.</p>
      </div>
    </div>
  </footer>
</body>
</html>

<style>
  .header { position: sticky; top: 0; z-index: 10; background: var(--bg); border-bottom: 1px solid var(--line); }
  .header-in { display: flex; align-items: center; gap: 8px 32px; flex-wrap: wrap; }
  .brand { display: flex; align-items: center; gap: 10px; color: var(--text); text-decoration: none; font-weight: 600; font-size: 18px; letter-spacing: -0.01em; }
  .header .brand { padding: 16px 0; }
  .tabs { display: flex; gap: 4px; overflow-x: auto; flex: 1 1 300px; align-self: stretch; }
  .tab {
    display: flex; align-items: center; padding: 0 14px; min-height: 58px; white-space: nowrap;
    font-size: 12px; color: var(--muted); text-decoration: none;
    border-bottom: 1px solid transparent; transition: color .15s, border-color .15s;
  }
  .tab:hover, .tab.on { color: var(--text); }
  .tab.on { border-bottom-color: var(--defense); }
  @media (max-width: 640px) {
    .tabs { flex-basis: 100%; margin: 0 calc(-1 * var(--gutter)); padding: 0 var(--gutter); }
    .tab { min-height: 48px; }
  }

  .foot { border-top: 1px solid var(--line); }
  .foot-in { padding-top: 40px; padding-bottom: 48px; display: flex; flex-direction: column; gap: 24px; }
  .foot-top { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; align-items: center; }
  .foot .brand { font-size: 16px; }
  .foot-links { display: flex; gap: 8px 24px; flex-wrap: wrap; font-size: 11px; }
  .foot-links a { color: var(--muted); text-decoration: none; display: inline-flex; align-items: center; min-height: 44px; }
  .foot-links a:hover { color: var(--text); }
  .notes { display: flex; flex-direction: column; gap: 8px; max-width: 920px; border-top: 1px solid var(--line); padding-top: 24px; font-size: 13px; line-height: 1.6; color: var(--muted-2); }
  .notes p { margin: 0; }
  .notes :global(a) { color: var(--muted); }
  .notes :global(a:hover) { color: var(--text); }
</style>
