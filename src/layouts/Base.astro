---
import { site } from '../../site.config';
import Logo from '../components/Logo.astro';
import { urlFor } from '../lib/data';
import { langOf, langs, switchPath, ui } from '../lib/i18n';
import '../styles/tokens.css';
import '../styles/base.css';

const lang = langOf(Astro.url);
const t = ui[lang];
const url = urlFor(lang);
const { title, description = site.description[lang] } = Astro.props;
const fullTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.tagline[lang]}`;
const colorVars = `:root{${Object.entries(site.colors).map(([k, v]) => `--${k}:${v}`).join(';')}}`;

const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site).href;
const ogImage = new URL(site.ogImage, Astro.site).href;
const isActive = (href: string) => (href === '/' ? path === url.page('/') : path.startsWith(url.page(href)));
// Вкладка-меню активна, якщо активний будь-який її пункт.
const tabActive = (tab: (typeof site.tabs)[number]) => (tab.children ? tab.children.some((c) => isActive(c.href)) : isActive(tab.href!));
// Та сама сторінка іншою мовою — абсолютні адреси для hreflang; x-default — англійська.
const alt = (l: (typeof langs)[number]) => new URL(switchPath(path, l), Astro.site).href;
const localHref = (href: string) => (href.startsWith('/') ? url.page(href) : href);
---
<!doctype html>
<html lang={t.htmlLang}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  <meta name="theme-color" content={site.colors.bg}>
  <link rel="canonical" href={canonical}>
  {langs.map((l) => <link rel="alternate" hreflang={l} href={alt(l)} />)}
  <link rel="alternate" hreflang="x-default" href={alt('en')}>
  <meta property="og:type" content="website">
  <meta property="og:site_name" content={site.name}>
  <meta property="og:locale" content={t.ogLocale}>
  {langs.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={ui[l].ogLocale} />)}
  <meta property="og:title" content={fullTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="sitemap" href="/sitemap-index.xml">
  <link rel="icon" href="/favicon.ico" sizes="48x48">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Onest:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap">
  <style is:inline set:html={colorVars}></style>
</head>
<body>
  <header class="header">
    <div class="wrap header-in">
      <a href={url.page('/')} class="brand"><Logo /><span>{site.name}</span></a>
      <nav aria-label={t.sections} class="tabs">
        {site.tabs.map((tab) => tab.children
          ? (
            <button type="button" popovertarget={`menu-${tab.id}`} class:list={['tab', 'mono', 'drop', { on: tabActive(tab) }]} style={`anchor-name: --menu-${tab.id}`}>{tab.label[lang]}</button>
            <div id={`menu-${tab.id}`} popover class="menu" style={`position-anchor: --menu-${tab.id}`}>
              <div class="mhead"><span class="mono">{tab.label[lang]}</span><button type="button" popovertarget={`menu-${tab.id}`} popovertargetaction="hide" class="mono mclose">{t.close}</button></div>
              {tab.children.map((c) => (
                <a href={url.page(c.href)} class:list={{ on: isActive(c.href) }} aria-current={isActive(c.href) ? 'page' : undefined}>
                  <span class="ml">{c.label[lang]}</span><span class="mn">{c.note[lang]}</span>
                </a>
              ))}
            </div>
          )
          : <a href={url.page(tab.href)} class:list={['tab', 'mono', { on: isActive(tab.href) }]} aria-current={isActive(tab.href) ? 'page' : undefined}>{tab.label[lang]}</a>
        )}
      </nav>
      <nav aria-label={t.switcher} class="langs">
        {langs.map((l) => (
          <a href={switchPath(path, l)} hreflang={l} lang={l} class:list={['tab', 'mono', { on: l === lang }]} aria-current={l === lang ? 'true' : undefined}>{l === 'uk' ? 'UA' : 'EN'}</a>
        ))}
      </nav>
    </div>
  </header>

  <main><slot /></main>

  <footer class="foot">
    <div class="wrap foot-in">
      <div class="foot-top">
        <span class="brand"><Logo size={18} />{site.name}</span>
        <nav aria-label={t.footerNav} class="mono foot-links">
          {site.footer.links.map((l) => <a href={localHref(l.href)}>{l.label[lang]}</a>)}
        </nav>
      </div>
      <div class="notes">
        {site.footer.notes[lang].map((n) => <p set:html={n} />)}
        <p>{t.author}: <a href={site.author.url}>{site.author.name[lang]}</a>.</p>
      </div>
    </div>
  </footer>
</body>
</html>

<style>
  .header { position: sticky; top: 0; z-index: 10; background: var(--bg); border-bottom: 1px solid var(--line); }
  .header-in { display: flex; align-items: center; gap: 8px 32px; flex-wrap: wrap; }
  .brand { display: flex; align-items: center; gap: 10px; color: var(--text); text-decoration: none; font-weight: 600; font-size: 18px; letter-spacing: -0.01em; }
  .header .brand { padding: 16px 0; }
  .tabs { display: flex; gap: 4px; overflow-x: auto; flex: 1 1 300px; align-self: stretch; }
  .langs { display: flex; gap: 4px; align-self: stretch; }
  .langs .tab { min-width: 44px; justify-content: center; }
  .tab {
    display: flex; align-items: center; padding: 0 14px; min-height: 58px; white-space: nowrap;
    font-size: 12px; color: var(--muted); text-decoration: none;
    border-bottom: 1px solid transparent; transition: color .15s, border-color .15s;
  }
  .tab:hover, .tab.on { color: var(--text); }
  .tab.on { border-bottom-color: var(--defense); }
  button.tab { background: none; border: 0; border-bottom: 1px solid transparent; cursor: pointer; gap: 8px; }
  button.tab.on { border-bottom-color: var(--defense); }
  /* Шеврон біля вкладки-меню */
  .drop::after { content: ''; width: 6px; height: 6px; margin-top: -3px; border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor; transform: rotate(45deg); }

  /* Випадаюче меню: нативний Popover (закривається кліком поза ним і Esc). Без anchor positioning —
     смуга під шапкою; з ним — під своєю вкладкою; на мобільному — панель знизу екрана. */
  .menu {
    position: fixed; inset: 60px 0 auto 0; margin: 0; padding: 8px;
    border: 1px solid var(--line-strong); border-radius: var(--radius-lg); background: var(--surface); color: var(--text);
  }
  @supports (anchor-name: --a) {
    .menu { inset: auto; top: anchor(bottom); left: anchor(left); width: 340px; }
  }
  .menu a { display: flex; flex-direction: column; gap: 2px; min-height: 44px; padding: 12px 14px; border-radius: var(--radius); color: var(--text); text-decoration: none; }
  .menu a:hover { background: var(--bg); color: var(--text); }
  .menu a:hover .ml, .menu a.on .ml { color: var(--defense); }
  .ml { font-size: 15px; font-weight: 600; transition: color .15s; }
  .mn { font-size: 13px; line-height: 1.4; color: var(--muted); }
  .mhead { display: none; }
  @media (max-width: 640px) {
    /* Мова — у верхньому рядку поруч із логотипом, вкладки переносяться на другий */
    .brand { order: 1; }
    .langs { order: 2; margin-left: auto; margin-right: -14px; }
    .tabs { order: 3; flex-basis: 100%; margin: 0 calc(-1 * var(--gutter)); padding: 0 var(--gutter); }
    .menu {
      inset: auto 0 0 0; width: auto; border-width: 1px 0 0; border-radius: var(--radius-lg) var(--radius-lg) 0 0;
      padding: 8px 8px calc(16px + env(safe-area-inset-bottom));
    }
    .menu::backdrop { background: rgb(0 0 0 / .55); }
    .mhead { display: flex; justify-content: space-between; align-items: center; padding: 0 0 0 14px; font-size: 11px; color: var(--muted-2); }
    .mclose { min-height: 44px; padding: 0 14px; background: none; border: 0; color: var(--defense); font-size: 11px; cursor: pointer; }
    .tab { min-height: 48px; }
  }

  .foot { border-top: 1px solid var(--line); }
  .foot-in { padding-top: 32px; padding-bottom: 40px; display: flex; flex-direction: column; gap: 16px; }
  .foot-top { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; align-items: center; }
  .foot .brand { font-size: 16px; }
  .foot-links { display: flex; gap: 8px 24px; flex-wrap: wrap; font-size: 11px; }
  .foot-links a { color: var(--muted); text-decoration: none; display: inline-flex; align-items: center; min-height: 44px; }
  .foot-links a:hover { color: var(--text); }
  .notes { display: flex; flex-direction: column; gap: 6px; max-width: 920px; border-top: 1px solid var(--line); padding-top: 16px; font-size: 12px; line-height: 1.55; color: var(--muted-2); }
  .notes p { margin: 0; }
  .notes :global(a) { color: var(--muted); }
  .notes :global(a:hover) { color: var(--text); }
</style>
