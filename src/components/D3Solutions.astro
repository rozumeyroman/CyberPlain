---
// Таблиця «Які рішення це роблять» для тактики й техніки D3FEND: лише класи, зіставлені з ними (d3fend[] класу).
import SolutionLinks from './SolutionLinks.astro';
import { url, plural, type SolutionClass, type Product, type D3Technique } from '../lib/data';

interface Props {
  rows: { cls: SolutionClass; products: Product[]; techniques: D3Technique[]; whole: boolean }[];
  empty: string;
}
const { rows, empty } = Astro.props;
---
{rows.length === 0
  ? <p class="soon-box">{empty}</p>
  : (
    <table class="tbl">
      <thead><tr><th>Рішення</th><th>Що робить</th><th>Техніки D3FEND</th></tr></thead>
      <tbody>
        {rows.map((s) => (
          <tr>
            <td><SolutionLinks cls={s.cls} products={s.products} /></td>
            <td data-label="Що робить" class:list={{ empty: !s.cls.data.simple }}>{s.cls.data.simple ?? '—'}</td>
            <td data-label="Техніки D3FEND">
              {s.whole && <span class="mono whole">Тактика загалом</span>}
              {s.techniques.length > 0 && s.techniques.length <= 3 && (
                <span class="ids">{s.techniques.map((t) => <a href={url.d3fendTechnique(t.id)} title={t.ua ?? t.en}>{t.id}</a>)}</span>
              )}
              {s.techniques.length > 3 && (
                <details class="more"><summary class="mono">{plural(s.techniques.length, 'техніка', 'техніки', 'технік')}</summary>
                  <span class="ids">{s.techniques.map((t) => <a href={url.d3fendTechnique(t.id)} title={t.ua ?? t.en}>{t.id}</a>)}</span>
                </details>
              )}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  )}

<style>
  .ids { display: flex; flex-wrap: wrap; gap: 4px 12px; }
  .ids a { font: 400 12px var(--font-mono); letter-spacing: .04em; text-decoration: none; display: inline-flex; align-items: center; min-height: 32px; }
  .whole { display: block; font-size: 11px; color: var(--muted); min-height: 32px; line-height: 32px; }
</style>
