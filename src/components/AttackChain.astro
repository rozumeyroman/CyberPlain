---
// Ланцюжок атаки: впорядкований список кроків; кожен крок — окрема стаття з якорем #step-N.
import AnalyticsSolutions from './AnalyticsSolutions.astro';
import TechRefs from './TechRefs.astro';
import { pageCtx, num, type AStep } from '../lib/data';

// nav — id списку кроків, до якого веде стрілка «↑» (на сторінці атаки — steps, на сторінці вразливості — chain-nav).
interface Props { steps: AStep[]; nav?: string }
const { steps, nav = 'steps' } = Astro.props;
const { t, url, d } = await pageCtx(Astro.url);
const x = t.analytics;
const order = (id: string) => d.tactics.findIndex((y) => y.id === id) + 1;
---
<ol class="chain">
  {steps.map((s) => (
    <li>
      <article class="step" id={`step-${s.n}`} aria-labelledby={`step-h-${s.n}`}>
        <div class="head">
          <span class="mono n">{x.attack.step(s.n)}</span>
          <a href={url.tactic(s.tactic.id)} class="chip tac">{num(order(s.tactic.id))} {s.tactic.data.title} · <span class="id-attack">{s.tactic.id}</span></a>
          {s.observed !== undefined && (
            <span class:list={['mono', 'obs', { likely: !s.observed }]}>{s.observed ? x.attack.observed : x.attack.likely}</span>
          )}
          <a href={`#${nav}`} class="act up" aria-label={x.attack.toSteps}>↑</a>
        </div>
        <h3 id={`step-h-${s.n}`}>{s.title}</h3>
        <p class="what">{s.what}</p>
        {s.result && (
          <div class="result"><span class="mono k">{x.attack.result}</span><p>{s.result}</p></div>
        )}
        {s.tools.length > 0 && (
          <div class="row"><span class="mono k">{x.attack.tools}</span><span class="chips">{s.tools.map((tool) => <span class="chip tool">{tool}</span>)}</span></div>
        )}
        <div class="row"><span class="mono k">{x.attack.techniques}</span><TechRefs items={s.techniques} /></div>
        <div class="row stop"><span class="mono k">{x.attack.stop}</span><AnalyticsSolutions items={s.solutions} how />
        </div>
        {s.gaps.length > 0 && (
          <div class="gaps">
            <span class="mono k">{x.gaps}</span>
            <ul>{s.gaps.map((g) => <li>{g}</li>)}</ul>
          </div>
        )}
      </article>
    </li>
  ))}
</ol>

<style>
  .chain { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 20px; }
  .step { scroll-margin-top: 130px; padding: 20px; border: 1px solid var(--line); border-left: 3px solid var(--attack); background: var(--bg); display: flex; flex-direction: column; gap: 14px; }
  .step:target { border-color: var(--attack); }
  .head { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; }
  .n { font-size: 12px; color: var(--attack); }
  .tac { min-height: 32px; }
  .obs { font-size: 11px; letter-spacing: .08em; text-transform: uppercase; padding: 4px 8px; border: 1px solid var(--attack); border-radius: 4px; color: var(--attack); }
  .obs.likely { border-style: dashed; border-color: var(--line-strong); color: var(--muted); }
  .up { margin-left: auto; display: inline-flex; align-items: center; justify-content: center; min-width: 44px; min-height: 44px; font-size: 16px; }
  h3 { margin: 0; font-size: 22px; line-height: 1.25; letter-spacing: -0.01em; }
  .what { margin: 0; max-width: 760px; font-size: 16px; line-height: 1.6; color: var(--text-2); }
  .result { padding: 12px 14px; border-left: 2px solid var(--attack); background: var(--surface); max-width: 760px; }
  .result .k { color: var(--attack); }
  .result p { margin: 6px 0 0; font-size: 15px; line-height: 1.55; color: var(--text-2); }
  .row { display: flex; flex-direction: column; gap: 6px; }
  .k { font-size: 11px; color: var(--muted-2); }
  .stop .k { color: var(--defense); }
  .tool { font-family: var(--font-mono); font-size: 12px; }
  .gaps { padding: 12px 14px; border: 1px dashed var(--line-strong); max-width: 760px; }
  .gaps ul { margin: 6px 0 0; padding-left: 18px; font-size: 14px; line-height: 1.55; color: var(--muted); }
</style>
