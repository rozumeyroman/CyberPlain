---
import { site } from '../../site.config';
import { pageCtx, introOf, d3fendSource } from '../lib/data';

const { lang, t } = await pageCtx(Astro.url);
const { source } = introOf('d3fend', lang);
const { href = source.url, label = t.source.d3fendOrig } = Astro.props;
const date = lang === 'en'
  ? new Date(d3fendSource.releaseDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })
  : d3fendSource.releaseDate.split('-').reverse().join('.');
---
<div class="src">
  <span>{t.source.d3fend(source.name.replace('D3FEND', 'D3FEND™'), d3fendSource.version, date, site.name)}</span>
  <a href={href} class="mono">{label}</a>
</div>

<style>
  .src { display: flex; justify-content: space-between; gap: 8px 16px; flex-wrap: wrap; align-items: center; padding: 18px 20px; border: 1px solid var(--line); font-size: 14px; color: var(--muted); }
  a { font-size: 11px; text-decoration: none; display: inline-flex; align-items: center; min-height: 44px; }
</style>
