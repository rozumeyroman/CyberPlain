---
import AttackSource from './AttackSource.astro';
import D3fendTags from './D3fendTags.astro';
import SolutionLinks from './SolutionLinks.astro';
import Fold from './Fold.astro';
import { pageCtx, num, type Tactic } from '../lib/data';

interface Props { tactic: Tactic }
const { tactic: t } = Astro.props;
const { lang, t: ui, url, d, pl } = await pageCtx(Astro.url);
const x = ui.tactic;
const i = d.tactics.findIndex((y) => y.id === t.id);
const prev = d.tactics[i - 1], next = d.tactics[i + 1];
const techniques = d.techniquesOf(t.id);
const solutions = d.solutionsFor(t);
const TOP = 6;
---
<section class="wrap page">
  <nav aria-label={ui.crumbs} class="mono crumbs">
    <a href={url.page('/mitre/')}>MITRE ATT&amp;CK</a><span aria-hidden="true">/</span><span aria-current="page">{num(i + 1)} {t.data.title}</span>
  </nav>

  <div class="head"><span class="num">{num(i + 1)}</span><span class="mono meta">{t.id}{lang === 'uk' && ` · ${t.data.en}`}</span><a href={url.mitre(t.id)} class="act orig" aria-label={ui.source.attackId(t.id)}>{ui.source.short}</a></div>
  <h1>{t.data.title}</h1>
  {t.data.short ? <p class="lead-text">{t.data.short}</p> : <p class="soon-box">{ui.soon}</p>}
  {t.data.analogy && <div class="note-box"><span class="mono attack">{ui.analogy}</span>{t.data.analogy}</div>}

  <Fold id="sol" title={x.sols} count={solutions.length ? pl(solutions.length, ui.n.solutions) : undefined}>
    {solutions.length === 0
      ? <p class="soon-box">{x.noSols}</p>
      : [solutions.slice(0, TOP), solutions.slice(TOP)].filter((part) => part.length > 0).map((part, k) => {
        const table = (
          <table class="tbl stage">
            <colgroup><col class="c1" /><col /><col class="c3" /><col class="c4" /></colgroup>
            {k === 0 && <thead><tr><th>{ui.solution}</th><th>{ui.what}</th><th>{x.thTech}</th><th>D3FEND</th></tr></thead>}
            <tbody>
              {part.map((s) => (
                <tr>
                  <td><SolutionLinks cls={s.cls} products={s.products} /></td>
                  <td data-label={ui.what} class:list={{ empty: !(s.note ?? s.cls.data.simple) }}>{s.note ?? s.cls.data.simple ?? ui.dash}</td>
                  <td data-label={x.thTech} class="cover inline">{x.of(s.techniques.length, techniques.length)}</td>
                  <td data-label="D3FEND" class="inline"><D3fendTags cls={s.cls} /></td>
                </tr>
              ))}
            </tbody>
          </table>
        );
        // Перші TOP — найкорисніші на етапі; решта згорнута, колонки однакові завдяки table-layout: fixed.
        return k === 0 ? table : <details class="rest"><summary class="act">{x.more(pl(part.length, ui.n.solutions))}</summary>{table}</details>;
      })
      }
  </Fold>

  <section class="sec" aria-labelledby="tech">
    <h2 class="sec-title" id="tech">{x.techs}{techniques.length > 0 && <span class="mono">{techniques.length}</span>}</h2>
    {techniques.length === 0
      ? <div class="soon-box">{x.noTechs}<br><a href={url.mitre(t.id)} class="act">{x.techsOrig}</a></div>
      : (
        <div class="techs">
          {techniques.map((y) => (
            <details class="tech">
              <summary>
                <span class="id-attack">{y.id}</span>
                <span class="tname"><span class="ua">{y.data.title}</span>{lang === 'uk' && <span class="en">{y.data.en}</span>}</span>
                {y.data.pain && <span class="badge-pain">{ui.pain}</span>}
              </summary>
              <div class="tbody">
                {y.data.simple ? <p>{y.data.simple}</p> : <p class="muted">{ui.soon}</p>}
                {y.data.analogy && <p class="muted"><b>{ui.analogy}.</b> {y.data.analogy}</p>}
                {y.data.quote && <p class="quote">{ui.quote(y.data.quote)}</p>}
                {y.data.defenses.length > 0 && (
                  <div class="chips">{d.classesOf(y).map((c) => <a href={url.solution(c.id)} class="chip">{c.data.title}</a>)}</div>
                )}
                <a href={url.technique(y.id)} class="act more">{x.details}</a>
              </div>
            </details>
          ))}
        </div>
      )}
  </section>

  <nav aria-label={x.pagerAria} class="pager">
    {prev
      ? <a href={url.tactic(prev.id)} class="card"><span class="mono dir">{x.prev}</span><span class="pname">{num(i)} {prev.data.title}</span></a>
      : <div class="card off"><span class="mono dir">{x.prev}</span><span>{x.first}</span></div>}
    {next
      ? <a href={url.tactic(next.id)} class="card right"><span class="mono dir">{x.next}</span><span class="pname">{num(i + 2)} {next.data.title}</span></a>
      : <div class="card right off"><span class="mono dir">{x.next}</span><span>{x.last}</span></div>}
  </nav>
</section>

<section class="wrap bottom"><AttackSource href={url.mitre(t.id)} /></section>

<style>
  .stage { table-layout: fixed; }
  .stage .c1 { width: 24%; } .stage .c3 { width: 96px; } .stage .c4 { width: 130px; }
  .rest > summary { list-style: none; cursor: pointer; display: inline-flex; align-items: center; min-height: 44px; padding: 0 14px; margin-top: 12px; border: 1px solid var(--line-strong); border-radius: var(--radius); }
  .rest > summary::-webkit-details-marker { display: none; }
  .rest > summary:hover { border-color: var(--defense); }
  .rest > summary::after { content: none; }
  .rest[open] > summary { display: none; }
  .rest .tbl { border-top: 0; }
  @media (max-width: 760px) { .stage .c1, .stage .c3, .stage .c4 { width: auto; } }
  .head { display: flex; gap: 10px; align-items: baseline; flex-wrap: wrap; margin-bottom: 12px; }
  .num { font-size: 44px; font-weight: 600; letter-spacing: -0.03em; color: var(--attack); }
  .meta { font-size: 12px; color: var(--muted-2); }
  .orig { margin-left: auto; display: inline-flex; align-items: center; min-height: 44px; }
  h1 { margin: 0 0 16px; font-size: clamp(36px, 8vw, 48px); line-height: 1.05; }
  .attack { color: var(--attack); }
  .cover { white-space: nowrap; }

  .techs { border-top: 1px solid var(--line); }
  .tech { border-bottom: 1px solid var(--line); }
  summary {
    display: flex; align-items: center; gap: 8px 16px; flex-wrap: wrap; min-height: 56px; padding: 12px 36px 12px 0;
    cursor: pointer; list-style: none; position: relative;
  }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; position: absolute; right: 8px; top: 50%; transform: translateY(-50%); font: 400 20px var(--font-mono); color: var(--muted); }
  .tech[open] summary::after { content: '−'; }
  summary:hover .ua { color: var(--defense-hover); }
  summary .id-attack { font-size: 13px; min-width: 64px; }
  .tname { display: flex; flex-direction: column; flex: 1 1 220px; }
  .ua { font-size: 17px; font-weight: 600; line-height: 1.3; transition: color .15s; }
  .en { font-size: 12px; color: var(--muted-2); }
  .tbody { padding: 0 0 20px 80px; display: flex; flex-direction: column; gap: 12px; max-width: 840px; }
  .tbody p { margin: 0; font-size: 15px; line-height: 1.6; color: var(--text-2); }
  .tbody .muted { color: var(--muted); }
  .tbody b { color: var(--text); font-weight: 600; }
  .quote { padding: 10px 14px; background: var(--surface); border-left: 2px solid var(--attack); }
  .more { display: inline-flex; align-items: center; min-height: 44px; align-self: flex-start; }
  @media (max-width: 640px) {
    .tbody { padding-left: 0; }
    /* «Часта біль» — під назвою техніки, а не під ID */
    summary { display: grid; grid-template-columns: 64px 1fr; gap: 6px 12px; align-items: baseline; }
    summary .badge-pain { grid-column: 2; justify-self: start; }
  }

  .pager { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 16px; margin-top: 56px; }
  .card { display: flex; flex-direction: column; gap: 6px; padding: 16px 18px; border: 1px solid var(--line); color: var(--text); text-decoration: none; font-size: 15px; transition: border-color .15s; }
  a.card:hover { border-color: var(--defense); color: var(--text); }
  .card.right { text-align: right; }
  .card.off { color: var(--line-hover); }
  .dir { font-size: 11px; color: var(--muted-2); }
  .off .dir { color: inherit; }
  .pname { font-weight: 600; }
  .bottom { padding-top: 40px; padding-bottom: 72px; }
</style>
