---
// Клас рішень і його продукти — усі посиланнями в розділ «Рішення». Продукти згорнуті, щоб рядок таблиці лишався коротким.
import { pageCtx, type SolutionClass, type Product } from '../lib/data';

interface Props { cls: SolutionClass; products: Product[] }
const { cls, products } = Astro.props;
const { t, url, pl } = await pageCtx(Astro.url);
---
<a href={url.solution(cls.id)} class="name">{cls.data.title}</a>
{products.length > 0 && (
  <details class="more">
    <summary class="act">{pl(products.length, t.n.products)}</summary>
    <div class="chips">{products.map((p) => <a href={url.solution(p.id)} class="chip">{p.data.title}</a>)}</div>
  </details>
)}
