---
import AttackSource from './AttackSource.astro';
import D3Groups from './D3Groups.astro';
import D3fendTags from './D3fendTags.astro';
import SolutionLinks from './SolutionLinks.astro';
import Fold from './Fold.astro';
import { pageCtx, num, type Technique } from '../lib/data';

interface Props { technique: Technique }
const { technique: t } = Astro.props;
const { lang, t: ui, url, d, pl } = await pageCtx(Astro.url);
const x = ui.technique;
const tactics = d.tacticsOf(t);
const order = (id: string) => d.tactics.findIndex((y) => y.id === id) + 1;
const defenses = d.classesOf(t);
const subs = d.subtechniquesOf(t);
const d3 = d.d3fendForAttack(t);
const TOP = 6;
---
<section class="wrap page">
  <nav aria-label={ui.crumbs} class="mono crumbs">
    <a href={url.page('/mitre/')}>MITRE ATT&amp;CK</a><span aria-hidden="true">/</span>
    <a href={url.tactic(tactics[0].id)}>{num(order(tactics[0].id))} {tactics[0].data.title}</a><span aria-hidden="true">/</span>
    <span aria-current="page">{t.id}</span>
  </nav>

  <div class="head"><span class="id-attack big">{t.id}</span>{lang === 'uk' && <span class="mono meta">{t.data.en}</span>}{t.data.pain && <span class="badge-pain">{ui.pain}</span>}<a href={url.mitre(t.id)} class="act orig" aria-label={ui.source.attackId(t.id)}>{ui.source.short}</a></div>
  <h1>{t.data.title}</h1>
  {t.data.simple ? <p class="lead-text">{t.data.simple}</p> : <p class="soon-box">{ui.soon}</p>}
  <div class="stages">
    <span class="mono k">{tactics.length > 1 ? x.stages : x.stage}</span>
    <div class="chips">{tactics.map((ta) => <a href={url.tactic(ta.id)} class="chip">{num(order(ta.id))} {ta.data.title} · {ta.id}</a>)}</div>
  </div>

  <div class="grid">
    {t.data.goal && <div class="note-box"><span class="mono attack">{x.goal}</span>{t.data.goal}</div>}
    {t.data.analogy && <div class="note-box"><span class="mono attack">{ui.analogy}</span>{t.data.analogy}</div>}
    {t.data.quote && <div class="note-box"><span class="mono muted">{x.quote}</span>{ui.quote(t.data.quote)}</div>}
  </div>

  {subs.length > 0 && (
    <section class="sec" aria-labelledby="subs">
      <h2 class="sec-title" id="subs">{x.subs}<span class="mono">{pl(subs.length, ui.n.subtechniques)}</span></h2>
      <ul class="subs">
        {subs.map((s) => (
          <li><a href={url.mitre(s.id)} class="sub">
            <span class="id-attack">{s.id}</span>
            <span class="sname"><span class="sua">{s.title}</span>{lang === 'uk' && s.ua && <span class="sen">{s.en}</span>}</span>
            <span class="mono ext" aria-label={x.extAria}>↗</span>
          </a></li>
        ))}
      </ul>
    </section>
  )}

  {t.data.questions.length > 0 && (
    <section class="sec" aria-labelledby="q">
      <h2 class="sec-title" id="q">{x.ask}</h2>
      <p class="note">{x.askHint}</p>
      <div class="qs">{t.data.questions.map((q) => <label class="q"><input type="checkbox"> <span>{q}</span></label>)}</div>
    </section>
  )}

  <Fold id="sol" title={x.sols} count={defenses.length ? pl(defenses.length, ui.n.solutions) : undefined}>
    {defenses.length === 0
      ? <p class="soon-box">{x.noSols}</p>
      : [defenses.slice(0, TOP), defenses.slice(TOP)].filter((part) => part.length > 0).map((part, k) => {
        const table = (
          <table class="tbl sols">
            <colgroup><col class="c1" /><col /><col class="c3" /></colgroup>
            {k === 0 && <thead><tr><th>{ui.solution}</th><th>{x.thWhat}</th><th>D3FEND</th></tr></thead>}
            <tbody>
              {part.map((c) => (
                <tr>
                  <td><SolutionLinks cls={c} products={d.productsOf(c.id)} /></td>
                  <td data-label={x.thWhat} class:list={{ empty: !c.data.simple }}>{c.data.simple ?? ui.dash}</td>
                  <td data-label="D3FEND" class="inline"><D3fendTags cls={c} /></td>
                </tr>
              ))}
            </tbody>
          </table>
        );
        // Як на сторінці етапу: перші TOP видно, решта — «Показати ще»; колонки однакові завдяки table-layout: fixed.
        return k === 0 ? table : <details class="rest"><summary class="act">{ui.tactic.more(pl(part.length, ui.n.solutions))}</summary>{table}</details>;
      })}
  </Fold>

  <section class="sec" aria-labelledby="d3">
    <h2 class="sec-title" id="d3">{x.d3}{d3.length > 0 && <span class="mono">{pl(d3.length, ui.n.techniques)}</span>}</h2>
    {d3.length === 0
      ? <p class="soon-box">{x.noD3}</p>
      : <>
          <p class="note">{x.d3note}</p>
          {d3.length > 12
            ? <details class="more-d3"><summary class="act">{x.showD3(pl(d3.length, ui.n.techniques))}</summary><D3Groups techniques={d3} /></details>
            : <D3Groups techniques={d3} />}
        </>}
  </section>

</section>

<section class="wrap bottom"><AttackSource href={url.mitre(t.id)} label={ui.source.attackId(t.id)} /></section>

<style>
  .head { display: flex; gap: 8px 12px; align-items: baseline; flex-wrap: wrap; margin-bottom: 12px; }
  /* Одна колонка 980px для всіх блоків, а не 700 для тексту й 1200 для таблиці */
  .page > :global(:not(.lead-text)), .bottom > :global(*) { max-width: 980px; }
  .page .soon-box { max-width: none; }
  .big { font-size: 20px; }
  .stages { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; margin: -12px 0 28px; }
  .stages .k { font-size: 11px; color: var(--muted-2); }
  .orig { margin-left: auto; display: inline-flex; align-items: center; min-height: 44px; }
  .meta { font-size: 12px; color: var(--muted-2); }
  h1 { margin: 0 0 16px; font-size: clamp(32px, 7vw, 44px); line-height: 1.1; }
  .attack { color: var(--attack); }
  .muted { color: var(--muted-2); }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: 16px; max-width: 980px; }
  .grid .note-box { max-width: none; font-size: 15px; line-height: 1.55; color: var(--text-2); }
  .qs { display: flex; flex-direction: column; gap: 8px; }
  .q { display: flex; gap: 12px; align-items: flex-start; padding: 12px 14px; border: 1px solid var(--line); font-size: 15px; line-height: 1.45; cursor: pointer; }
  .q input { width: 18px; height: 18px; margin: 2px 0 0; accent-color: var(--defense); flex: none; }
  .subs { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: 8px; max-width: 980px; }
  .sub { display: flex; gap: 12px; align-items: baseline; min-height: 44px; height: 100%; padding: 10px 14px; border: 1px solid var(--line); color: var(--text); text-decoration: none; transition: border-color .15s; }
  .sub:hover { border-color: var(--defense); color: var(--text); }
  .sub .id-attack { font-size: 12px; flex: none; }
  .sname { display: flex; flex-direction: column; flex: 1; font-size: 15px; line-height: 1.35; }
  .sen { font-size: 12px; color: var(--muted-2); }
  .ext { font-size: 11px; color: var(--defense); }
  .more-d3 summary { display: inline-flex; align-items: center; min-height: 44px; padding: 0 14px; margin-bottom: 12px; border: 1px solid var(--line-strong); border-radius: var(--radius); cursor: pointer; list-style: none; }
  .more-d3 summary::-webkit-details-marker { display: none; }
  .more-d3 summary:hover { border-color: var(--defense); }
  .more-d3[open] summary { display: none; }
  .note { margin: 0 0 16px; max-width: 760px; font-size: 14px; line-height: 1.55; color: var(--muted); }
  .bottom { padding-top: 40px; padding-bottom: 72px; }
  .sols { table-layout: fixed; }
  .sols .c1 { width: 26%; } .sols .c3 { width: 130px; }
  @media (max-width: 760px) { .sols .c1, .sols .c3 { width: auto; } }
  .rest > summary { list-style: none; cursor: pointer; display: inline-flex; align-items: center; min-height: 44px; padding: 0 14px; margin-top: 12px; border: 1px solid var(--line-strong); border-radius: var(--radius); }
  .rest > summary::-webkit-details-marker { display: none; }
  .rest > summary:hover { border-color: var(--defense); }
  .rest[open] > summary { display: none; }
  .rest .tbl { border-top: 0; }
</style>
