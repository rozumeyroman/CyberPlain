---
import { site } from '../../site.config';
import { pageCtx, introOf, attackSource } from '../lib/data';

const { lang, t } = await pageCtx(Astro.url);
const { source } = introOf('attack', lang);
const { href = source.url, label = t.source.attackOrig } = Astro.props;
---
<div class="src">
  <span>{t.source.attack(source.name.replace('ATT&CK', 'ATT&CK®'), attackSource.version, site.name)}</span>
  <a href={href} class="act">{label}</a>
</div>

<style>
  .src { display: flex; justify-content: space-between; gap: 8px 16px; flex-wrap: wrap; align-items: center; padding: 18px 20px; border: 1px solid var(--line); font-size: 14px; color: var(--muted); }
  a { display: inline-flex; align-items: center; min-height: 44px; }
</style>
