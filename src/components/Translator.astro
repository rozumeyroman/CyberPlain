---
// Перекладач термінів без JS: radio + label + :checked ~.
const terms = [
  {
    term: 'Lateral Movement', chip: 'Lateral Movement', source: 'ATT&CK · TA0008', kind: 'attack',
    simple: 'Зловмисник уже всередині й переходить з одного комп’ютера на інші — як злодій, що з передпокою пішов по всіх кімнатах.',
    url: 'https://attack.mitre.org/tactics/TA0008/', site: 'attack.mitre.org',
  },
  {
    term: 'Phishing', chip: 'Phishing', source: 'ATT&CK · T1566', kind: 'attack',
    simple: 'Підроблений лист чи повідомлення, щоб людина сама відчинила двері: перейшла за посиланням, ввела пароль або запустила файл.',
    url: 'https://attack.mitre.org/techniques/T1566/', site: 'attack.mitre.org',
  },
  {
    term: 'Ransomware', chip: 'Ransomware', source: 'ATT&CK · T1486', kind: 'attack',
    simple: 'Програма шифрує файли компанії й вимагає викуп за ключ. Злодій нічого не виносить — він міняє замки й продає вам нові ключі.',
    url: 'https://attack.mitre.org/techniques/T1486/', site: 'attack.mitre.org',
  },
  {
    term: 'Multi-factor Authentication', chip: 'MFA', source: 'D3FEND · Harden', kind: 'defense',
    simple: 'Другий замок на дверях: навіть знаючи пароль, зловмисник не зайде без коду з телефону власника.',
    url: 'https://d3fend.mitre.org/technique/d3f:Multi-factorAuthentication/', site: 'd3fend.mitre.org',
  },
];

// Одне правило на термін: підсвітити його чип і показати його панель.
const css = terms.map((_, i) =>
  `#t${i}:checked~.chips label[for=t${i}]{border-color:var(--defense);color:var(--text)}` +
  `#t${i}:focus-visible~.chips label[for=t${i}]{outline:2px solid var(--defense);outline-offset:2px}` +
  `#t${i}:checked~.panels .p${i}{display:block}`
).join('');
---
<div class="tr cell">
  {terms.map((_, i) => <input type="radio" name="term" id={`t${i}`} checked={i === 0} />)}
  <div class="bar">
    <span class="mono label">Переклад · EN → UA</span>
    <span class="dots" aria-hidden="true"><i></i><i></i><i class="on"></i></span>
  </div>
  <div class="chips">
    {terms.map((t, i) => <label for={`t${i}`} class="mono">{t.chip}</label>)}
  </div>
  <div class="panels">
    {terms.map((t, i) => (
      <div class={`pn p${i}`}>
        <div class="row"><span class="mono k">Термін</span><span class="v term">{t.term}</span></div>
        <div class="row"><span class="mono k">Джерело</span><span class:list={['v', 'mono', 'src', t.kind]}>{t.source}</span></div>
        <div class="row last"><span class="mono k">Просто</span><span class="v simple">{t.simple}</span></div>
        <div class="orig"><a href={t.url} class="mono">Оригінал на {t.site} ↗</a></div>
      </div>
    ))}
  </div>
</div>
<style is:inline set:html={css}></style>

<style>
  .tr { width: 100%; border: 1px solid var(--line); background: var(--surface); }
  .tr input { position: absolute; opacity: 0; pointer-events: none; }
  .bar { display: flex; justify-content: space-between; align-items: center; padding: 12px 16px; border-bottom: 1px solid var(--line); }
  .label { font-size: 11px; color: var(--muted); }
  .dots { display: flex; gap: 6px; }
  .dots i { width: 8px; height: 8px; background: var(--line-strong); }
  .dots i.on { background: var(--defense); }
  .chips { display: flex; gap: 8px; flex-wrap: wrap; padding: 16px; }
  .chips label {
    display: inline-flex; align-items: center; min-height: 44px; padding: 8px 12px;
    font-size: 11px; border-radius: 2px; cursor: pointer;
    border: 1px solid var(--line-strong); color: var(--muted); transition: color .15s, border-color .15s;
  }
  .chips label:hover { color: var(--text); }
  .panels { border-top: 1px solid var(--line); }
  .pn { display: none; }
  .row { display: grid; grid-template-columns: 112px 1fr; border-bottom: 1px solid var(--line); }
  .row.last { border-bottom: 0; }
  .k { font-size: 11px; color: var(--muted-2); padding: 14px 16px; border-right: 1px solid var(--line); }
  .v { padding: 12px 16px; }
  .term { font-size: 18px; font-weight: 600; }
  .src { font-size: 12px; padding-top: 14px; }
  .src.attack { color: var(--attack); }
  .src.defense { color: var(--defense); }
  .simple { font-size: 17px; line-height: 1.55; padding-bottom: 18px; }
  .orig { padding: 12px 16px; border-top: 1px solid var(--line); }
  .orig a { font-size: 11px; text-decoration: none; display: inline-flex; align-items: center; min-height: 44px; }
  @media (max-width: 640px) {
    .row { grid-template-columns: 92px 1fr; }
    .k { padding: 14px 12px; }
    .v { padding: 12px; }
    .simple { font-size: 16px; }
  }
</style>
