---
import Base from '../../../layouts/Base.astro';
import D3fendSource from '../../../components/D3fendSource.astro';
import { pageCtx, introOf, num } from '../../../lib/data';
import { langParams } from '../../../lib/i18n';

export const getStaticPaths = langParams;

const { lang, t, url, d, pl } = await pageCtx(Astro.url);
const { intro } = introOf('d3fend', lang);
const { d3fendTactics: tactics } = d;

const cut = intro.title.indexOf(',');
const [titleA, titleB] = cut < 0 ? [intro.title, ''] : [intro.title.slice(0, cut + 1), intro.title.slice(cut + 1).trim()];
const capCut = intro.caveat.indexOf('. ') + 1;
---
<Base title="MITRE D3FEND™" description={intro.lead}>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-text">
        <div class="mono kicker">// MITRE D3FEND™</div>
        <h1>{titleA}{titleB && <><br><span class="dim">{titleB}</span></>}</h1>
        <p class="lead">{intro.lead}</p>
        <p class="body">{intro.body}</p>
      </div>
      <div class="hero-side">
        <dl class="terms">
          {intro.terms.map((t) => (
            <div class="term-row"><dt class="mono">{t.term}</dt><dd><b>{t.title}</b> {t.text}</dd></div>
          ))}
        </dl>
        <div class="example">
          <div class="mono ex-label">{t.example}</div>
          <div class="ex-chain">
            {intro.example.map((e, i) => (
              <>{i > 0 && <span class="arrow" aria-hidden="true">→</span>}<span class="pill">{e.label} <span class="mono">{e.id}</span></span></>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap stages">
    <div class="stages-head">
      <div>
        <div class="mono kicker muted">{t.d3fend.stages(tactics.length, tactics.reduce((n, x) => n + x.all.length, 0))}</div>
        <h2>{intro.sectionTitle}</h2>
        <p class="body">{intro.sectionLead}</p>
      </div>
      <p class="caveat"><b>{intro.caveat.slice(0, capCut)}</b>{intro.caveat.slice(capCut)}</p>
    </div>

    <ol class="tactics">
      {tactics.map((x) => (
        <li class="tc">
          <a href={url.d3fendTactic(x.id)} class="tc-head">
            <span class="tc-top"><span class="num">{num(x.order)}</span><span class="mono id">{pl(x.all.length, t.n.techniques)}</span></span>
            <span class="names"><span class="ua">{x.title}</span>{lang === 'uk' && <span class="en">{x.en}</span>}</span>
            {x.short && <span class="short">{x.short}</span>}
          </a>
          <ul class="cats">
            {x.categories.map((c) => (
              <li><a href={url.d3fendTechnique(c.id)}><span>{c.title}</span><span class="mono cid">{c.id}</span></a></li>
            ))}
          </ul>
        </li>
      ))}
    </ol>
  </section>

  <section class="wrap bottom"><D3fendSource /></section>
</Base>


<style>
  .kicker { font-size: 12px; color: var(--defense); margin-bottom: 24px; }
  .kicker.muted { color: var(--muted-2); margin-bottom: 14px; }
  .dim { color: var(--muted-2); }
  .body { margin: 0; font-size: 16px; line-height: 1.6; color: var(--muted); max-width: 620px; }

  .hero {
    border-bottom: 1px solid var(--line);
    background-color: var(--bg);
    background-image:
      radial-gradient(520px 360px at 85% 20%, color-mix(in srgb, var(--defense) 16%, transparent), transparent 70%),
      radial-gradient(var(--line) 1px, transparent 1px);
    background-size: auto, 16px 16px;
  }
  .hero-grid { display: grid; }
  .hero-text { padding: 56px 0 32px; }
  .hero-side { padding: 0 0 56px; display: flex; flex-direction: column; justify-content: center; gap: 16px; }
  h1 { margin: 0 0 24px; font-size: clamp(34px, 9vw, 52px); line-height: 1.04; }
  .lead { margin: 0 0 16px; font-size: 18px; line-height: 1.6; color: var(--text-2); max-width: 520px; }
  @media (min-width: 1008px) {
    .hero-grid { grid-template-columns: 1fr 1fr; }
    .hero-text { padding: 72px 48px 64px 0; }
    .hero-side { padding: 72px 0 64px 48px; border-left: 1px solid var(--line); }
  }

  .terms { margin: 0; border: 1px solid var(--line); background: var(--surface); }
  .term-row { display: grid; grid-template-columns: 120px 1fr; border-bottom: 1px solid var(--line); }
  .term-row:last-child { border-bottom: 0; }
  dt { font-size: 11px; color: var(--muted-2); padding: 16px; border-right: 1px solid var(--line); }
  dd { margin: 0; font-size: 15px; line-height: 1.55; padding: 14px 16px; }
  dd b { font-weight: 600; }
  .example { padding: 14px 16px; border: 1px dashed var(--line-strong); }
  .ex-label { font-size: 11px; color: var(--muted-2); margin-bottom: 10px; }
  .ex-chain { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; font-size: 14px; line-height: 1.4; }
  .pill { padding: 6px 10px; border-radius: var(--radius); background: color-mix(in srgb, var(--defense) 12%, transparent); }
  .pill .mono { font-size: 10px; color: var(--defense); }
  .arrow { color: var(--defense); }
  @media (max-width: 640px) {
    .term-row { grid-template-columns: 96px 1fr; }
    dt { padding: 16px 12px; }
    dd { padding: 14px 12px; }
  }

  .stages { padding-top: 72px; padding-bottom: 24px; }
  .stages-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; flex-wrap: wrap; margin-bottom: 40px; }
  h2 { margin: 0 0 10px; font-size: clamp(30px, 6vw, 38px); }
  .caveat { margin: 0; max-width: 380px; padding: 14px 16px; border: 1px solid var(--line); font-size: 14px; line-height: 1.55; color: var(--muted); }
  .caveat b { color: var(--text); font-weight: 600; }

  .tactics { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: 16px; }
  .tc { display: flex; flex-direction: column; border: 1px solid var(--line); background: var(--surface); transition: border-color .15s; }
  .tc:hover { border-color: var(--line-hover); }
  .tc-head { display: flex; flex-direction: column; gap: 10px; padding: 18px 18px 16px; color: var(--text); text-decoration: none; border-bottom: 1px solid var(--line); }
  .tc-head:hover .ua { color: var(--defense-hover); }
  .tc-top { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; }
  .num { font-size: 30px; font-weight: 600; letter-spacing: -0.03em; color: var(--defense); }
  .id { font-size: 10px; color: var(--muted-2); }
  .names { display: flex; flex-direction: column; gap: 2px; }
  .ua { font-size: 17px; font-weight: 600; line-height: 1.25; transition: color .15s; }
  .en { font-size: 12px; color: var(--muted-2); }
  .short { font-size: 14px; line-height: 1.5; color: var(--text-2); }

  .cats { list-style: none; margin: 0; padding: 6px 0; }
  .cats a { display: flex; justify-content: space-between; align-items: center; gap: 12px; min-height: 44px; padding: 8px 18px; color: var(--text-2); text-decoration: none; font-size: 14px; line-height: 1.35; }
  .cats a:hover { color: var(--defense-hover); }
  .cid { font-size: 10px; color: var(--muted-2); white-space: nowrap; }

  .bottom { padding-top: 40px; padding-bottom: 72px; }
</style>
