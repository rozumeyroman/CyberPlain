---
// /mitre/TA0043/ — етап (тактика), /mitre/T1595/ — техніка. ID не перетинаються (перевіряє loadData).
import Base from '../../layouts/Base.astro';
import TacticPage from '../../components/TacticPage.astro';
import TechniquePage from '../../components/TechniquePage.astro';
import { loadData } from '../../lib/data';

export async function getStaticPaths() {
  const { tactics, techniques } = await loadData();
  return [
    ...tactics.map((tactic) => ({ params: { id: tactic.id }, props: { tactic } })),
    ...techniques.map((technique) => ({ params: { id: technique.id }, props: { technique } })),
  ];
}

const { tactic, technique } = Astro.props;
const e = tactic ?? technique!;
---
<Base title={`${e.data.ua} (${e.id})`} description={tactic ? tactic.data.short : technique!.data.simple}>
  {tactic ? <TacticPage tactic={tactic} /> : <TechniquePage technique={technique!} />}
</Base>
