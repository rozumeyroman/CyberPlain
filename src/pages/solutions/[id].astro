---
// /solutions/<id>/ — клас рішень (vm) або продукт (rapid7-insightvm). ID не перетинаються (перевіряє loadData).
import Base from '../../layouts/Base.astro';
import AttackGroups from '../../components/AttackGroups.astro';
import D3Groups from '../../components/D3Groups.astro';
import D3fendTags from '../../components/D3fendTags.astro';
import { loadData, url, type SolutionClass, type Product } from '../../lib/data';

export async function getStaticPaths() {
  const { classes, products } = await loadData();
  return [
    ...classes.map((cls) => ({ params: { id: cls.id }, props: { cls } })),
    ...products.map((product) => ({ params: { id: product.id }, props: { product } })),
  ];
}

const { cls, product } = Astro.props as { cls?: SolutionClass; product?: Product };
const d = await loadData();
const own = product ? product.data.classes.map((r) => d.classById.get(r.id)!) : [];
// Техніки продукту — ті, від яких захищають його класи; самі зв'язки лежать лише в defenses[] технік.
const techIds = new Set((cls ? [cls] : own).flatMap((c) => d.techniquesDefendedBy(c.id).map((t) => t.id)));
const attack = d.techniques.filter((t) => techIds.has(t.id));
const title = cls ? cls.data.ua : product!.data.name;
const simple = cls ? cls.data.simple : product!.data.simple;
// D3FEND: техніки й «тактики загалом» з d3fend[] класу (продукту — усіх його класів), по тактиках D3FEND.
const mine = (cls ? [cls] : own).map((c) => d.d3fendOf(c));
const d3techs = [...new Set(mine.flatMap((m) => m.techniques))];
const d3whole = [...new Set(mine.flatMap((m) => m.wholeTactics))];
---
<Base title={title} description={simple}>
  <section class="wrap page">
    <nav aria-label="Навігаційний ланцюжок" class="mono crumbs">
      <a href="/solutions/">Рішення</a><span aria-hidden="true">/</span>
      {product && <><a href={url.solution(own[0].id)}>{own[0].data.ua}</a><span aria-hidden="true">/</span></>}
      <span aria-current="page">{title}</span>
    </nav>

    <div class="mono tag">{cls ? '[ Клас рішень ]' : <>[ Продукт · <a href={url.vendor(d.vendorId(product!.data.vendor))}>{product!.data.vendor}</a> ]</>}</div>
    <h1>{title}</h1>
    {cls?.data.en && <p class="en">{cls.data.en}</p>}
    {simple ? <p class="lead-text">{simple}</p> : <p class="soon-box">Пояснення готується.</p>}

    <div class="facts">
      {cls && cls.data.d3fend.length > 0 && <div><span class="mono k">D3FEND</span><D3fendTags cls={cls} /></div>}
      {product?.data.url && <div><span class="mono k">Джерело</span><a href={product.data.url} class="mono src">{new URL(product.data.url).hostname} ↗</a></div>}
      {product && <div><span class="mono k">Класи</span><span class="chips">{own.map((c) => <a href={url.solution(c.id)} class="chip">{c.data.ua}</a>)}</span></div>}
    </div>

    {cls && (
      <section class="sec" aria-labelledby="pr">
        <h2 class="sec-title" id="pr">Продукти</h2>
        {d.productsOf(cls.id).length === 0
          ? <p class="soon-box">Продукти цього класу ще не додані.</p>
          : <div class="chips">{d.productsOf(cls.id).map((p) => <a href={url.solution(p.id)} class="chip">{p.data.name}</a>)}</div>}
      </section>
    )}

    <section class="sec" aria-labelledby="tt">
      <h2 class="sec-title" id="tt">Від яких технік атаки захищає · ATT&amp;CK{techIds.size > 0 && <span class="mono">{techIds.size} технік</span>}</h2>
      {attack.length === 0
        ? <p class="soon-box">Зв'язки з техніками атак ще не додані.</p>
        : <AttackGroups techniques={attack} />}
    </section>

    <section class="sec" aria-labelledby="dd">
      <h2 class="sec-title" id="dd">Які захисні заходи виконує · D3FEND{d3techs.length > 0 && <span class="mono">{d3techs.length} технік</span>}</h2>
      {d3techs.length === 0 && d3whole.length === 0
        ? <p class="soon-box">Зв'язки з D3FEND ще не додані.</p>
        : <D3Groups techniques={d3techs} whole={d3whole} />}
    </section>
  </section>
</Base>

<style>
  .tag { font-size: 12px; color: var(--defense); margin-bottom: 16px; }
  h1 { margin: 0 0 8px; font-size: clamp(32px, 7vw, 48px); line-height: 1.1; }
  .en { margin: 0 0 20px; font-size: 14px; color: var(--muted-2); }
  .facts { display: flex; flex-direction: column; gap: 12px; margin-top: 8px; }
  .facts > div { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
  .src { font-size: 11px; text-decoration: none; display: inline-flex; align-items: center; min-height: 44px; }
  .k { font-size: 11px; color: var(--muted-2); min-width: 72px; }
</style>
