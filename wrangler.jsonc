{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cyberplain",
  "compatibility_date": "2026-10-01",
  // Вимкнено, щоб WAF-правило домену не можна було обійти через *.workers.dev (див. CLAUDE.md).
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "cyberplain.alestalab.top", "custom_domain": true }],
  "assets": {
    "directory": "./dist"
  }
}
